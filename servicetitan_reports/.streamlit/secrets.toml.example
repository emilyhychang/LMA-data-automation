# Copy this file to .streamlit/secrets.toml for local use.
# Never commit the real secrets.toml file.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-value"
client_id = "replace-with-your-google-client-id"
client_secret = "replace-with-your-google-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[access]
allowed_emails = ["approved.person@example.com"]
admin_emails = ["administrator@example.com"]

[database]
# Use the Supabase Session pooler connection string with SSL enabled.
url = "postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

[google_sheets]
revenue_spreadsheet_id = "19IdcStsC024mIoOEoel-I-tZO-dBSby3jwHcUl80Pgo"
new_leads_spreadsheet_id = "1QAtvpIVhxOPc72Px3A1j6l9exDA4dPgVrsQUWcvFa2A"
worksheet_name = "Sheet1"
# For local use only, this may point to the downloaded JSON key outside the repo.
credentials_file = "/absolute/path/to/service-account-key.json"

[google_service_account]
# For hosted Streamlit, copy the matching fields from the downloaded JSON key.
# Never commit real values.
type = "service_account"
project_id = "replace-with-project-id"
private_key_id = "replace-with-private-key-id"
private_key = """-----BEGIN PRIVATE KEY-----
replace-with-private-key
-----END PRIVATE KEY-----
"""
client_email = "replace-with-service-account-email"
client_id = "replace-with-client-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "replace-with-client-certificate-url"

[looker_studio]
revenue_embed_url = "https://datastudio.google.com/embed/reporting/e537e267-faf6-4518-aa6c-a28e1e35c6e6/page/S0t7F"
new_leads_embed_url = "https://datastudio.google.com/embed/reporting/939c1d6e-32bf-4f88-a26d-d32bedad3dcc/page/ixt7F"
